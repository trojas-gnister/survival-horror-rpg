# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=password
MONGODB_DATABASE=final_transmission

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Chroma Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
# Alternative models: qwen2:1.5b, phi3:mini, gemma2:2b

# Game Configuration
GAME_DIFFICULTY=normal
MAX_NIGHTS=14
STARTING_FUEL=100.0
STARTING_SANITY=100.0
STARTING_BATTERY=100.0
STARTING_FOOD_DAYS=7

# Logging
LOG_LEVEL=INFO
